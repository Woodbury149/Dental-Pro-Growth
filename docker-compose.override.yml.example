# Local development overrides
# Copy to docker-compose.override.yml to enable

version: '3.8'

services:
  backend:
    environment:
      DEBUG: "true"
      LOG_LEVEL: "debug"
    volumes:
      - ./src:/app/src
      - ./package.json:/app/package.json
    command: npm run server

  frontend:
    environment:
      REACT_APP_DEBUG: "true"
    volumes:
      - ./frontend/src:/app/frontend/src
    stdin_open: true
    tty: true
